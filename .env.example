# Plantilla: copia este archivo como .env y completa los valores marcados con <...>.
# Nunca guardes credenciales reales en este archivo ni en el código.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info
TZ_NEGOCIO=America/Lima

# Base de datos de Tranky (npm run db:create crea el rol y las bases con estos valores)
DB_HOST=localhost
DB_PORT=5432
DB_USER=tranky
DB_PASSWORD=<contraseña-fuerte-del-rol-de-base-de-datos>
DB_NAME=tranky_db
# Base que usa npm test (recrea su esquema en cada ejecución)
DB_NAME_TEST=tranky_test

# Contenedor Docker de Postgres y su superusuario (solo lo usa npm run db:create, se conecta por socket local sin contraseña)
DOCKER_DB_CONTAINER=<nombre-del-contenedor-postgres>
DOCKER_DB_ADMIN_USER=<superusuario-del-contenedor>

# Sesión. Genera valores aleatorios largos, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<secreto-aleatorio-de-al-menos-32-caracteres>
JWT_EXPIRES_IN=8h
OTP_PEPPER=<secreto-aleatorio>

# RF-R-01: valores a definir con negocio
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
OTP_TTL_MINUTOS=5
OTP_MAX_INTENTOS=3
OTP_REENVIO_SEGUNDOS=60
# Solo desarrollo: devuelve el OTP en la respuesta para probar sin WhatsApp/SMS
OTP_DEV_ECHO=true

# Pagos
PAGO_TIMEOUT_MINUTOS=30
CIP_VIGENCIA_HORAS=24
IGV_TASA=0.18
PASARELA_YAPE=mock
PASARELA_CARD=mock
PASARELA_CIP=mock
WEBHOOK_SECRET_MOCK=<secreto-aleatorio-para-firmar-webhooks-de-la-pasarela-mock>
# Tarifa simulada de la pasarela mock (tarifas reales por cotizar)
MOCK_COMISION_FIJA=0
MOCK_COMISION_PORCENTAJE=0

# RF-R-14: link de pago por WhatsApp
PAY_LINK_BASE_URL=http://localhost:5173/pagar/
PAY_LINK_TTL_HORAS=72
PAY_LINK_CHECKOUT_TTL_MINUTOS=15

# RF-R-13: canales por defecto (WHATSAPP, EMAIL, SMS)
NOTIFICACIONES_CANALES=WHATSAPP,EMAIL
NOTIFICACIONES_MAX_INTENTOS=5

# Habilita /api/v1/dev/* (simulador de webhooks). Nunca en producción.
ENABLE_DEV_ROUTES=true

# Contraseñas de los usuarios de prueba que crea npm run db:seed (solo desarrollo)
SEED_PASSWORD_RESIDENTES=<contraseña-de-prueba-residentes>
SEED_PASSWORD_ADMIN=<contraseña-de-prueba-administradoras>
